# Copie para .env (nunca versionado) e preencha no servidor. Sem valores reais neste arquivo.
# O .env é lido por server.js, backend/worker.mjs e tools/*-payments.mjs (process.loadEnvFile).
# A URL pública do checkout NÃO fica aqui: a fonte única é CAKTO_CHECKOUT_URL em src/content/site.js.

# --- Geral ---
NODE_ENV=production
# Porta do servidor Node (server.js). Em desenvolvimento, o Vite (5173) encaminha /api para ela.
PORT=3000
# Domínio público do site, só esquema + host (ex.: https://www.exemplo.com.br). Usado no e-mail
# de orientação, nas mensagens do bot e na verificação de origem (CSRF).
PUBLIC_SITE_URL=
# Quantos proxies de confiança acrescentam X-Forwarded-For na frente do Node (0 = nenhum).
TRUST_PROXY_HOPS=0
# Só em desenvolvimento local via http: permite o cookie de sessão sem Secure. Proibido em produção.
# ACCESS_INSECURE_COOKIES=1

# --- Banco (MySQL 8) ---
# Use DATABASE_URL=mysql://usuario:senha@host:3306/banco OU as variáveis separadas abaixo.
DATABASE_URL=
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=true      (conexão TLS; o certificado do servidor não é verificado)

# --- Produto e política de acesso ---
# ID do produto na Cakto (painel ou campo data.product.id do webhook). Não deduza da URL do checkout.
CAKTO_PRODUCT_ID=
# Opcional: restringe a uma oferta específica do produto (data.offer.id).
CAKTO_OFFER_ID=
# Duração do acesso contada a partir do pagamento confirmado: "lifetime" ou "days:N".
# Vazio = nenhum acesso é concedido (pagamentos ficam registrados aguardando a definição).
ACCESS_POLICY=

# --- Cakto: webhook ---
# Segredo exibido no painel da Cakto ao criar o webhook (usado para validar X-Cakto-Signature).
CAKTO_WEBHOOK_SECRET=
# "signature" (padrão, HMAC em X-Cakto-Signature). Use "secret_field" SOMENTE se a conta não
# enviar assinatura; nunca há troca automática entre os modos.
CAKTO_WEBHOOK_AUTH=signature

# --- Cakto: API de consulta de pedidos (OAuth2, escopo de leitura de pedidos) ---
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=

# --- Telegram ---
# Token do BotFather. Só no servidor.
TELEGRAM_BOT_TOKEN=
# Nome público do bot, sem @ (ex.: BrunoAcessoBot).
TELEGRAM_BOT_USERNAME=
# ID numérico do grupo privado (negativo, ex.: -100xxxxxxxxxx). Confira com: npm run telegram:check
TELEGRAM_GROUP_ID=
# Segredo enviado pelo Telegram em X-Telegram-Bot-Api-Secret-Token (16+ caracteres A-Z a-z 0-9 _ -).
TELEGRAM_WEBHOOK_SECRET=

# --- E-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente com domínio autenticado (SPF/DKIM), ex.: "Bruno <acesso@exemplo.com.br>"
EMAIL_FROM=

# --- Códigos de verificação ---
# Segredo aleatório de 32+ caracteres para derivar/validar códigos. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_HASH_SECRET=
# Limites por hora (padrões: 5 por e-mail, 20 por IP)
# ACCESS_LIMIT_EMAIL_HOUR=5
# ACCESS_LIMIT_IP_HOUR=20
